---
import profile from '../data/profile.json';
import publications from '../data/publications.json';
const papers = [...publications].sort((a, b) => b.year - a.year);
---
{papers.length > 0 && (
  <section id="publications" aria-labelledby="publications-heading">
    <h2 id="publications-heading">Publications</h2>
    <ol class="publications">
      {papers.map(paper => (
        <li>
          <h3><a href={paper.url}>{paper.title}</a></h3>
          <p class="authors">{paper.authors.map((author, i) => <>{i > 0 && ', '}{author === profile.name ? <strong>{author}</strong> : author}</>)}</p>
          <p class="publication-meta">
            <em>{paper.venue}</em>{paper.citation && ` ${paper.citation}`} ({paper.year})
            {paper.status === 'preprint' && ' · Preprint'}
            {paper.preprint && <> · <a href={paper.preprint}>arXiv</a></>}
          </p>
        </li>
      ))}
    </ol>
  </section>
)}
