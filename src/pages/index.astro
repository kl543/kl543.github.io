---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import Publications from '../components/Publications.astro';
import Talks from '../components/Talks.astro';
import profile from '../data/profile.json';
import research from '../data/research.json';
const writing = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const scholar = 'scholar' in profile && typeof profile.scholar === 'string' ? profile.scholar : undefined;
---
<Page home>
  <section id="about" class="intro" aria-labelledby="name">
    <div class="intro-text">
      {profile.bio.map(paragraph => <p>{paragraph}</p>)}
      <p>I am a {profile.title} in {profile.advisor}’s group at the <a href={profile.education[0].url}>{profile.institution}</a>.</p>
      <ul class="contact-links" aria-label="Contact and professional links">
        <li><a href={`mailto:${profile.email}`}>Email</a></li>
        <li><a href={profile.cvUrl} aria-label="Curriculum vitae (PDF)">CV</a></li>
        {scholar && <li><a href={scholar}>Google Scholar</a></li>}
        <li><a href={profile.github}>GitHub</a></li>
        <li><a href={profile.linkedin}>LinkedIn</a></li>
      </ul>
    </div>
    <img class="portrait" src="/images/kaiming-liu.jpg" alt="Portrait of Kaiming Liu" width="420" height="420" fetchpriority="high" decoding="async" />
  </section>

  <section id="research" aria-labelledby="research-heading">
    <h2 id="research-heading">Research</h2>
    <ol class="project-list">
      {research.projects.map((project, index) => (
        <li id={project.id}>
          <span class="project-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{project.title}</h3>
            <p class="project-descriptor">{project.descriptor}</p>
            <p>{project.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <Publications />

  <section id="background" aria-labelledby="background-heading">
    <h2 id="background-heading">Background</h2>
    <p>{profile.background}</p>
    <p id="education">Before UIUC, I studied in {profile.education[1].institution}’s Special Class for the Gifted Young ({profile.education[2].shortDates}), then completed a {profile.education[1].degree} ({profile.education[1].shortDates}).</p>
  </section>

  {writing.length > 0 && (
    <section id="writing" aria-labelledby="writing-heading">
      <h2 id="writing-heading">Writing</h2>
      <ul class="writing-list">
        {writing.map(post => <li><a href={`/writing/${post.id}/`}>{post.data.title}</a><p>{post.data.description}</p></li>)}
      </ul>
    </section>
  )}
  <Talks />
</Page>
