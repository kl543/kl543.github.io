---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Page from '../../layouts/Page.astro';

export async function getStaticPaths() {
  return (await getCollection('writing', ({ data }) => !data.draft)).map(post => ({
    params: { slug: post.id }, props: { post },
  }));
}
interface Props { post: CollectionEntry<'writing'>; }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Page title={`${post.data.title} — Kaiming Liu`} description={post.data.description} hasWriting>
  <article class="prose">
    <p class="back-link"><a href="/#writing">← All writing</a></p>
    <h1>{post.data.title}</h1>
    <p class="dates"><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time></p>
    <Content />
  </article>
</Page>
