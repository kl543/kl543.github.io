---
import profile from '../data/profile.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hasWriting?: boolean;
  home?: boolean;
}
const { title = `${profile.name} — Physics & Scientific Machine Learning`, description = profile.description, hasWriting = false, home = false } = Astro.props;
const updated = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${profile.updated}T00:00:00Z`));
const canonical = new URL(Astro.url.pathname, profile.website);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${profile.website}images/kaiming-liu.jpg`} />
    <meta property="og:image:alt" content="Portrait of Kaiming Liu" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class:list={['page', { home }]}>
      <header class="site-header">
        {home ? <h1 id="name" class="site-name">{profile.name}</h1> : <a class="site-name" href="/">{profile.name}</a>}
        {!home && <nav aria-label="Main navigation">
          <a href="/#about">About</a>
          <a href="/#research">Research</a>
          {hasWriting && <a href="/#writing">Writing</a>}
          <a href={profile.cvUrl} aria-label="Curriculum vitae (PDF)">CV</a>
        </nav>}
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <span>Updated {updated}</span>
      </footer>
    </div>
  </body>
</html>
