---
import profile from '../data/profile.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}
const { title = `${profile.name} — Physics & Scientific Machine Learning`, description = profile.description, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/^\/404\/?$/, '/404.html'), profile.website);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/academic-serif-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${profile.website}images/kaiming-liu.jpg`} />
    <meta property="og:image:alt" content="Portrait of Kaiming Liu" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class:list={['page', { home }]}>
      <header class="site-header">
        {home ? <h1 id="name" class="site-name">{profile.name}</h1> : <a class="site-name" href="/">{profile.name}</a>}
      </header>
      <main id="main" tabindex="-1"><slot /></main>
    </div>
  </body>
</html>
